<Window x:Class="TourAgencyApp.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourAgencyApp.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="750" Width="900" Icon="/res/world_travel_icon.ico"
        MinHeight="550" MinWidth="550" SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged">
    <Window.Background>
        <ImageBrush ImageSource="/res/backgroubd4.png" Stretch="Fill"/>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="Cornsilk"/>

        <StackPanel x:Name="panel" Grid.Column="0" VerticalAlignment="Center">
            <Label Foreground="Black" FontSize="30" HorizontalAlignment="Center">Страница входа</Label>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20" >
                <Label FontSize="20">Зайти как:</Label>
                <RadioButton FontSize="20" Margin="10,0,10,0" VerticalContentAlignment="Center" IsChecked="{Binding IsClient}">Клиент</RadioButton>
                <RadioButton FontSize="20" Margin="10,0,10,0" VerticalContentAlignment="Center" IsChecked="{Binding IsEmployee}">Сотрудник</RadioButton>
            </WrapPanel>
            <Label Margin="20,0,20,0" FontSize="16">Введите логин:</Label>
            <TextBox Margin="20,5,20,10" Height="40" FontSize="20" Text="{Binding Username}"></TextBox>
            <Label Margin="20,0,20,0" FontSize="16">Введите пароль:</Label>
            <PasswordBox x:Name="psw" Margin="20,5,20,10" Height="40" PasswordChanged="psw_PasswordChanged" ></PasswordBox>
            <Button x:Name="btn_signIn" Margin="50,20,50,20" FontSize="18" Height="40" Command="{Binding SignCommand}" >Войти</Button>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30">
                <Label FontSize="14">Нет аккаунта?</Label>
                <Button x:Name="btn_register" Background="Transparent" BorderThickness="0" Foreground="Blue" FontSize="14" Command="{Binding RegisterCommand}">Зарегистрируйтесь</Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
