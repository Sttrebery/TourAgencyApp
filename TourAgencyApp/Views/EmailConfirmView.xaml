<Window x:Class="TourAgencyApp.Views.EmailConfirmView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourAgencyApp.Views"
        mc:Ignorable="d"
        Title="EmailConfirmView" Height="350" Width="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Margin="10" VerticalAlignment="Bottom" FontSize="24">Введите код подтверждения, пришедший на почту:</TextBlock>
        <TextBox Grid.Row="1" Margin="10" Height="30" VerticalAlignment="Top"></TextBox>
        <Button Grid.Row="1" Grid.Column="1" Margin="10" VerticalAlignment="Top" FontSize="20">Подтвердить</Button>
    </Grid>
</Window>
