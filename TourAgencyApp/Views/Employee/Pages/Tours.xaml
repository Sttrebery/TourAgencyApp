<Page x:Class="TourAgencyApp.Views.Employee.Pages.Tours"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAgencyApp.Views.Employee.Pages"
      xmlns:l="clr-namespace:TourAgencyApp"
      xmlns:controls="clr-namespace:TourAgencyApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="600"
      Title="Tours">
    
    <Page.Resources>
        <ResourceDictionary>
            <l:ByteArrayToImageConverter x:Key="ByteToImage" />
            <l:EnumDescriptionConverter x:Key="enumConverter" />
            <l:BoolToYesNoConverter x:Key="boolConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Background="AliceBlue" VerticalScrollBarVisibility="Auto">
        <TabControl>
            <TabItem Header="Актуальные туры">
                <StackPanel>
                    <DataGrid x:Name="actual_tours" ItemsSource="{Binding ActualTours}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Cost}" />
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" />
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxTouristCount}" />
                            <DataGridTextColumn Header="Есть свободные места" Binding="{Binding HasAvailableSpots, Converter={StaticResource boolConverter}}" />
                            <DataGridTemplateColumn Header="Фото">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Margin="10" Height="25" Command="{Binding DataContext.ShowPhotoCommand, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">Посмотреть фото</Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Добавить тур" HorizontalContentAlignment="Center" Selector.Selected="TabItem_Selected">
                <StackPanel Margin="30" >
                    <Label>Название тура*:</Label>
                    <TextBox Text="{Binding TourName}"></TextBox>
                    <Label>Стоимость тура*:</Label>
                    <TextBox>
                        <TextBox.Text>
                            <Binding Path="TourCost">
                                <Binding.ValidationRules>
                                    <l:DecimalValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <Label>Дата начала*:</Label>
                    <DatePicker SelectedDate="{Binding StartDate}"></DatePicker>
                    <Label>Дата окончания*:</Label>
                    <DatePicker SelectedDate="{Binding EndDate}"></DatePicker>
                    <Label>Описание тура:</Label>
                    <TextBox Text="{Binding Description}" TextWrapping="Wrap" Height="150"></TextBox>
                    <Label>Максимальное количество туристов*:</Label>
                    <TextBox>
                        <TextBox.Text>
                            <Binding Path="TouristMaxCount">
                                <Binding.ValidationRules>
                                    <l:IntValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Label>Ответственный сотрудник*:</Label>
                    <ComboBox ItemsSource="{Binding Path=AllEmployees}"
                              SelectedValue="{Binding Path=SelectedEmployeeID}"
                              SelectedValuePath="ID">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="." Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Surname}" Margin="2,5,2,5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="2,5,2,5"></TextBlock>
                                    <TextBlock Text="{Binding Patronimyc}" Margin="2,5,2,5"></TextBlock>
                                    <TextBlock Text="-" Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Position, Converter={StaticResource enumConverter}}" Margin="5"></TextBlock>
                                </WrapPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Страна посещения:</Label>
                    <ComboBox
                        ItemsSource="{Binding Path=Countries}"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding Path=CountryID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Транспорт:</Label>
                    <ComboBox
                        ItemsSource="{Binding Path=Transports}"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding Path=TransportID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Отель:</Label>
                    <ComboBox ItemsSource="{Binding AllHotels}"
                              SelectedValue="{Binding HotelID}"
                              SelectedValuePath="ID">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="-" Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Margin="10" Height="35" Width="150" HorizontalAlignment="Left" Command="{Binding AddPhotoCommand}">Загрузить фото</Button>
                    <ListView ItemsSource="{Binding Images}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Превью">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Path=PhotoValue, Converter={StaticResource ByteToImage}}" 
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Height="150" Stretch="Uniform" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.DeletePhotoCommand, 
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                                Удалить
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Margin="10" HorizontalAlignment="Center" >
                        <Button Margin="20,0,20,0" Height="40" Width="100" Command="{Binding AddTourCommand}" IsEnabled="True">Добавить</Button>
                        <Button Margin="20,0,20,0" Height="40" Width="100" Command="{Binding ClearTourCommand}">Очистить</Button>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Редактировать тур" HorizontalContentAlignment="Center" Selector.Selected="TabItem_Selected">
                <StackPanel Margin="30,20,20,20" >
                    <Label Style="{StaticResource LabelStyle1}" Margin="10,20,0,0">Выберите тур:</Label>
                    <ComboBox  Style="{StaticResource ComboboxStyle1}" Selector.SelectionChanged="ComboBox_SelectionChanged"
                          ItemsSource="{Binding ActualTours}" 
                          SelectedValuePath="ID"
                          SelectedValue="{Binding TourToEditID}">     
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Название тура*:</Label>
                    <TextBox Text="{Binding TourName}"></TextBox>
                    <Label>Стоимость тура*:</Label>
                    <TextBox>
                        <TextBox.Text>
                            <Binding Path="TourCost">
                                <Binding.ValidationRules>
                                    <l:DecimalValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <Label>Дата начала*:</Label>
                    <DatePicker SelectedDate="{Binding StartDate}"></DatePicker>
                    <Label>Дата окончания*:</Label>
                    <DatePicker SelectedDate="{Binding EndDate}"></DatePicker>
                    <Label>Описание тура:</Label>
                    <TextBox Text="{Binding Description}" TextWrapping="Wrap" Height="150"></TextBox>
                    <Label>Максимальное количество туристов*:</Label>
                    <TextBox>
                        <TextBox.Text>
                            <Binding Path="TouristMaxCount">
                                <Binding.ValidationRules>
                                    <l:IntValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Label>Ответственный сотрудник*:</Label>
                    <ComboBox ItemsSource="{Binding Path=AllEmployees}"
                              SelectedValue="{Binding Path=SelectedEmployeeID}"
                              SelectedValuePath="ID">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="." Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Surname}" Margin="2,5,2,5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="2,5,2,5"></TextBlock>
                                    <TextBlock Text="{Binding Patronimyc}" Margin="2,5,2,5"></TextBlock>
                                    <TextBlock Text="-" Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Position, Converter={StaticResource enumConverter}}" Margin="5"></TextBlock>
                                </WrapPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Страна посещения:</Label>
                    <ComboBox
                        ItemsSource="{Binding Path=Countries}"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding Path=CountryID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Транспорт:</Label>
                    <ComboBox
                        ItemsSource="{Binding Path=Transports}"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding Path=TransportID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Отель:</Label>
                    <ComboBox ItemsSource="{Binding AllHotels}"
                              SelectedValue="{Binding HotelID}"
                              SelectedValuePath="ID">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="-" Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Margin="10" Height="35" Width="150" HorizontalAlignment="Left" Command="{Binding AddPhotoCommand}">Загрузить фото</Button>
                    <ListView ItemsSource="{Binding Images}" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Превью">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Path=PhotoValue, Converter={StaticResource ByteToImage}}" 
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Height="150" Stretch="Uniform" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.DeletePhotoCommand, 
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                                Удалить
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <WrapPanel Margin="10" HorizontalAlignment="Center" >
                        <Button Margin="20,0,20,0" Height="40" Width="100" Command="{Binding EditTourCommand}" IsEnabled="True">Сохранить</Button>
                        <Button Margin="20,0,20,0" Height="40" Width="100" Command="{Binding CancelCommand}">Отмена</Button>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Удалить тур">
                <StackPanel>
                    <Label Style="{StaticResource LabelStyle1}" Margin="30,20,0,0">Выберите тур, который хотите удалить</Label>
                    <ComboBox Style="{StaticResource ComboboxStyle1}" Width="550"
                              ItemsSource="{Binding ActualTours}" 
                              SelectedValuePath="ID"
                              SelectedValue="{Binding TourToDeleteID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}" Margin="5"></TextBlock>
                                    <TextBlock Text="-" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding EndDate, StringFormat=dd.MM.yyyy}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button HorizontalAlignment="Right" Width="150" FontSize="16" Margin="0,20,40,0" Padding="5" Command="{Binding DeleteTourCommand}">Удалить тур</Button>
                </StackPanel>
                
            </TabItem>
            
            <TabItem Header="Архивные туры">
                <DataGrid ItemsSource="{Binding ArchiveTours}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding Cost}" />
                        <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" />
                        <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" />
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxTouristCount}" />
                        <DataGridTemplateColumn Header="Фото">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Margin="10" Height="25" Command="{Binding DataContext.ShowPhotoCommand, 
                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                         CommandParameter="{Binding}">Посмотреть фото</Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</Page>
