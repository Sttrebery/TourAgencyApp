<Page x:Class="TourAgencyApp.Views.Employee.Pages.Tours"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAgencyApp.Views.Employee.Pages"
      xmlns:l="clr-namespace:TourAgencyApp"
      xmlns:controls="clr-namespace:TourAgencyApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="600"
      Title="Tours">
    
    <Page.Resources>
        <ResourceDictionary>
            <l:ByteArrayToImageConverter x:Key="ByteToImage" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Background="AliceBlue" VerticalScrollBarVisibility="Auto">
        <TabControl>
            <TabItem Header="Актуальные туры">
                <StackPanel>
                    <DataGrid x:Name="actual_tours" ItemsSource="{Binding ActualTours}" AutoGenerateColumns="False" IsReadOnly="True" LostFocus="actual_tours_LostFocus">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                            <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Добавить тур" HorizontalContentAlignment="Center">
                <StackPanel Margin="30" >
                    <Label>Название тура*:</Label>
                    <TextBox Text="{Binding TourName}"></TextBox>
                    <Label>Стоимость тура*:</Label>
                    <TextBox>
                        <TextBox.Text>
                            <Binding Path="TourCost">
                                <Binding.ValidationRules>
                                    <l:DecimalValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <Label>Дата начала*:</Label>
                    <DatePicker SelectedDate="{Binding StartDate}"></DatePicker>
                    <Label>Дата окончания*:</Label>
                    <DatePicker SelectedDate="{Binding EndDate}"></DatePicker>
                    <Label>Описание тура:</Label>
                    <TextBox Text="{Binding Description}" Height="150" Width="400"></TextBox>
                    <Label>Максимальное количество туристов*:</Label>
                    <TextBox>
                        <TextBox.Text>
                            <Binding Path="TouristMaxCount">
                                <Binding.ValidationRules>
                                    <l:IntValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <Label>Ответственный сотрудник*:</Label>
                    <Label Content="{Binding SelectedEmployeeFullName}"></Label>
                    <ComboBox ItemsSource="{Binding AllEmployees}"
                              SelectedValue="{Binding SelectedEmployee}"
                              SelectedValuePath="ID">
                        <!--todo:DataTemplate-->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="-" Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Surname}" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding Patronimyc}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Страна посещения:</Label>
                    <ComboBox
                        ItemsSource="{Binding Path=Countries}"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding Path=CountryID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Транспорт:</Label>
                    <ComboBox
                        ItemsSource="{Binding Path=Transports}"
                        SelectedValuePath="ID"
                        SelectedValue="{Binding Path=TransportID}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label>Отель:</Label>
                    <ComboBox ItemsSource="{Binding AllHotels}"
                              SelectedValue="{Binding Hotel}"
                              SelectedValuePath="ID">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="-" Margin="1,5,1,5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--todo: Add Command-->
                    <Button Margin="10" Height="35" Width="150" HorizontalAlignment="Left" Command="{Binding AddPhotoCommand}">Загрузить фото</Button>
                    <controls:ViewingPhotoControl Images="{Binding Images}">
                    </controls:ViewingPhotoControl>

                    <WrapPanel Margin="10" HorizontalAlignment="Center" >
                        <Button Margin="20,0,20,0" Height="40" Width="100" Command="{Binding AddTourCommand}" IsEnabled="True">Добавить</Button>
                        <Button Margin="20,0,20,0" Height="40" Width="100" Command="{Binding ClearTourCommand}">Очистить</Button>
                    </WrapPanel>
                    
                    
                </StackPanel>
            </TabItem>
            <TabItem Header="Удалить тур">
                <StackPanel>
                    <Label Style="{StaticResource LabelStyle1}" Margin="30,20,0,0">Выберите тур, который хотите удалить</Label>
                    <ComboBox Style="{StaticResource ComboboxStyle1}" Width="550"
                              ItemsSource="{Binding ActualToursNames}" 
                              SelectedValuePath="ID"
                              SelectedValue="{Binding TourToDelete}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ID}" Margin="5"></TextBlock>
                                    <TextBlock Text="-" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding Name}" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding StartDate}" Margin="5"></TextBlock>
                                    <TextBlock Text="{Binding EndDate}" Margin="5"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button HorizontalAlignment="Right" Width="150" FontSize="16" Margin="0,20,40,0" Padding="5" Command="{Binding DeleteTourCommand}">Удалить тур</Button>
                </StackPanel>
                
            </TabItem>
            <TabItem Header="Архивные туры">
                <DataGrid ItemsSource="{Binding ArchiveTours}"  AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                        <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                        <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                        <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</Page>
