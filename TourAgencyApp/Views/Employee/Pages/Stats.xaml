<Page x:Class="TourAgencyApp.Views.Employee.Pages.Stats"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAgencyApp.Views.Employee.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="700"
      Title="Stats">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Background="#c2dbfc" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource BorderStyle1}">
                <StackPanel Margin="10">
                    <Label Style="{StaticResource LabelStyle2}">Самый популярный тур</Label>
                    <DataGrid ItemsSource="{Binding TopTour}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                            <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border  Grid.Row="1" Style="{StaticResource BorderStyle1}">
                <StackPanel Margin="10">
                    <Label Style="{StaticResource LabelStyle2}">Самый НЕ популярный тур</Label>
                    <DataGrid ItemsSource="{Binding AntiTopTour}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                            <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource BorderStyle1}">
                <WrapPanel Margin="10" Orientation="Horizontal">
                    <Label Style="{StaticResource LabelStyle2}">Самый активный турист</Label>
                    <TextBlock Margin="20,0,20,0" FontSize="20" TextDecorations="Underline" Text="{Binding TopTourist}"></TextBlock>
                </WrapPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
