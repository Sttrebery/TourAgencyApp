<Page x:Class="TourAgencyApp.Views.Employee.Pages.CheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAgencyApp.Views.Employee.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CheckPage">
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Background="AliceBlue" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <Label Style="{StaticResource LabelPageHeader}">Проверить находится ли клиент в туре</Label>
            <Label Style="{StaticResource LabelStyle2}" Margin="30,0,0,0">Выберите клиента:</Label>
            <ComboBox FontSize="22" Margin="30,0,30,0" ItemsSource="{Binding AllClients}" SelectedValue="{Binding SelectedClient}"></ComboBox>
            <Button Margin="20" Style="{StaticResource ButtonStyle1}" Width="200" Command="{Binding CheckCommand}">Проверить</Button>
        </StackPanel>
       
        
    </ScrollViewer>
</Page>
