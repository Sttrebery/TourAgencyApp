<Page x:Class="TourAgencyApp.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:local="clr-namespace:TourAgencyApp.Views"
      xmlns:convs="clr-namespace:TourAgencyApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Page.Resources>
        <ResourceDictionary>
            <convs:ByteArrayToImageConverter x:Key="ByteToImageConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    
    
    <ScrollViewer Background="#c2dbfc" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Label Style="{StaticResource LabelPageHeader}" Content="Мой профиль" Padding="20"></Label>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- основная информация -->
                <StackPanel Margin="5,0,10,0" HorizontalAlignment="Center">
                    <WrapPanel Margin="10">
                        <Label Margin="0,0,2,0" Style="{StaticResource LabelStyle2}">Фамилия:</Label>
                        <TextBox Style="{StaticResource TextboxProfileStyle}" Text="{Binding Surname}"></TextBox>
                    </WrapPanel>

                    <WrapPanel Margin="10">
                        <Label Margin="20,0,26,0" Style="{StaticResource LabelStyle2}">Имя:</Label>
                        <TextBox Style="{StaticResource TextboxProfileStyle}" Text="{Binding Name}"></TextBox>
                    </WrapPanel>

                    <WrapPanel Margin="10">
                        <Label Style="{StaticResource LabelStyle2}">Отчество:</Label>
                        <TextBox Style="{StaticResource TextboxProfileStyle}" Text="{Binding Patronymic}"></TextBox>
                    </WrapPanel>

                    <WrapPanel Margin="10">
                        <Label Margin="0,0,6,0" Style="{StaticResource LabelStyle2}">Телефон:</Label>
                        <!-- wpfx работает -->
                        <wpfx:MaskedTextBox Width="220" FontSize="20" Height="40" IncludePromptInValue="True" Mask="+7(999) 999-99-99" Text="{Binding Phone}"></wpfx:MaskedTextBox>
                    </WrapPanel>

                    <WrapPanel Margin="10">
                        <Label Margin="0,0,10,0" Style="{StaticResource LabelStyle2}">Почта:</Label>
                        <TextBox Width="260" Style="{StaticResource TextboxProfileStyle}" Text="{Binding Email}"></TextBox>
                    </WrapPanel>

                    <WrapPanel Margin="20,0,20,0" HorizontalAlignment="Center">
                        <Button Margin="20" Style="{StaticResource ButtonStyle1}" Command="{Binding SaveChangesCommand}">Сохранить</Button>
                        <Button Margin="20" Style="{StaticResource ButtonStyle1}" Command="{Binding ClearCommand}">Отмена</Button>
                    </WrapPanel>

                </StackPanel>
                
                <!-- фото и пароль -->
                <StackPanel Margin="5,0,5,0">
                    <Label Style="{StaticResource LabelStyle2}">
                        Фото:
                    </Label>
                    <StackPanel>
                        <Image Width="200" Height="200" Source="/res/avatar.jpg" Stretch="Uniform" Visibility="{Binding DefaultPhoto}">
                        </Image>

                        <Image Width="200" Height="200" Source="{Binding Photo, Converter={StaticResource ByteToImageConverter}}" Visibility="{Binding UserPhoto}"/>
                    </StackPanel>
                    
                    <Button Margin="10" Style="{StaticResource ButtonStyle1}" Command="{Binding LoadPhotoCommand}">
                        Изменить фото
                    </Button>

                    <Button Margin="10" Style="{StaticResource ButtonStyle1}" Command="{Binding ChangePasswordCommand}">
                        Изменить пароль
                    </Button>
                    
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
