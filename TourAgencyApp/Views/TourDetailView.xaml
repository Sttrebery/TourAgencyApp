<Window x:Class="TourAgencyApp.Views.TourDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourAgencyApp.Views"
        xmlns:convs ="clr-namespace:TourAgencyApp"
        mc:Ignorable="d"
        Title="Детали тура" Height="450" Width="800">

    <Window.Resources>
        <convs:ByteArrayToImageConverter x:Key="ByteToImageConverter"/>

        
        <!-- Анимация перехода -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation 
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" 
                Duration="0:0:0.8"/>
        </Storyboard>

        <Storyboard x:Key="SlideTransition">
            <ThicknessAnimation 
                Storyboard.TargetProperty="Margin"
                From="10,0,0,0" To="0,0,0,0"
                Duration="0:0:0.6"/>
            <DoubleAnimation 
                Storyboard.TargetProperty="Opacity"
                From="0.5" To="1" 
                Duration="0:0:0.6"/>
        </Storyboard>
    </Window.Resources>
    
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal">
                <TextBlock>
                    Тур:
                </TextBlock>
                <TextBlock Text="{Binding TourName}">
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock>
                    Даты проведения:
                </TextBlock>
                <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}">
                </TextBlock>
                <TextBlock Text=" - ">
                </TextBlock>
                <TextBlock Text="{Binding EndDate, StringFormat=dd.MM.yyyy}">
                </TextBlock>
            </StackPanel>
            
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="stack_panel_1" Grid.Column="0" Margin="10">
                <WrapPanel Orientation="Vertical" >
                    <TextBlock>Описание:</TextBlock>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Border.Width>
                            <Binding ElementName="stack_panel_1" Path="ActualWidth" />
                        </Border.Width>
                        <TextBlock Text="{Binding Description}" Height="100" TextWrapping="Wrap">
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock>Страна:</TextBlock>
                    <TextBlock Text="{Binding CountryName}"></TextBlock>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock>Тип трансфера:</TextBlock>
                    <TextBlock Text="{Binding TransportName}"></TextBlock>
                </WrapPanel>

                <WrapPanel>
                    <TextBlock>Отель:</TextBlock>
                    <TextBlock Text="{Binding HotelName}"></TextBlock>
                </WrapPanel>

            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20">
                <WrapPanel>
                    <TextBlock>Размер группы:</TextBlock>
                    <TextBlock Text="{Binding MaxTouristCount}"></TextBlock>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock>Стоимость:</TextBlock>
                    <TextBlock Text="{Binding Cost}"></TextBlock>
                </WrapPanel>

                <!-- Элемент для отображения изображения -->

                <!-- Основное изображение -->
                <Border Name="border_image" Grid.Row="1" Margin="20" Background="Black">
                    <Image Source="{Binding SelectedPhoto.PhotoValue, Converter={StaticResource ByteToImageConverter}}"
                   Stretch="Uniform">
                        <Image.Width>
                            <Binding ElementName="border_image" Path="ActualWidth" />
                        </Image.Width>
                        <!-- Триггеры для анимации -->
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPhotoChanged}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>

                <!-- Управление -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="10">
                    <Button Content="◄" Command="{Binding PreviousPhotoCommand}" 
                    FontSize="20" Width="40" Height="40" Margin="5"/>

                    <Button Content="►" Command="{Binding NextPhotoCommand}" 
                    FontSize="20" Width="40" Height="40" Margin="5"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
