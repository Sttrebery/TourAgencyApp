<Window x:Class="TourAgencyApp.Views.SearchExtended"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourAgencyApp.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="700" Width="600" Icon="/res/world_travel_icon.ico"
        MinHeight="200" MinWidth="500">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel  HorizontalAlignment="Center">
            <Label Margin="40,60,40,10" FontSize="36" HorizontalAlignment="Center">Поиск тура</Label>
            <Label Margin="20,20,20,0" FontSize="26">Начало тура</Label>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20" >
                <TextBlock FontSize="24">с</TextBlock>
                <DatePicker x:Name="dtp_1" Margin="20,0,20,0" FontSize="20"
                            SelectedDate="{Binding Date1}"></DatePicker>
                <TextBlock FontSize="24">по</TextBlock>
                <DatePicker x:Name="dtp_2" Margin="20,0,20,0" FontSize="20"
                            SelectedDate="{Binding Date2}"></DatePicker>
            </WrapPanel>

            <WrapPanel Margin="20" >
                <TextBlock FontSize="24">Выберите страну:</TextBlock>
                <ComboBox x:Name="cb_country" Margin="20,0,20,0" FontSize="20"
                          ItemsSource="{Binding Countries}"
                          SelectedValue="{Binding Country}" ></ComboBox>
            </WrapPanel>

            <Label Margin="20,20,20,0" FontSize="24">Способ передвижения</Label>
            <ComboBox x:Name="cb_transfer" Margin="20,0,20,20" FontSize="20"
                      ItemsSource="{Binding Transports}"
                      SelectedValue="{Binding Transport}"></ComboBox>

            <WrapPanel Margin="20,50,20,50" HorizontalAlignment="Center">
                <Button x:Name="btn_find" Margin="20,0,20,0" FontSize="26" Height="50" Width="150" Command="{Binding ExtSearchCommand}">Поиск</Button>
                <Button x:Name="btn_reset" Margin="20,0,20,0" FontSize="26" Height="50" Width="150" Command="{Binding ClearExtendedCommand}">Сброс</Button>
            </WrapPanel>

        </StackPanel>

    </ScrollViewer>
</Window>
