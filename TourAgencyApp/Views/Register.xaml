<Window x:Name="registerWindow" x:Class="TourAgencyApp.Views.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfx="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:TourAgencyApp.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="850" Width="900" Icon="/res/world_travel_icon.ico"
        MinHeight="550" MinWidth="550" DataContextChanged="registerWindow_DataContextChanged">
    <Window.Background>
        <ImageBrush ImageSource="/res/backgroubd4.png" Opacity="0.7"/>
    </Window.Background>

    <ScrollViewer Background="Beige" Margin="25" BorderBrush="BurlyWood" BorderThickness="3" VerticalScrollBarVisibility="Auto">
        <StackPanel  HorizontalAlignment="Center">
            <Label Margin="40,60,40,10" FontSize="36" HorizontalAlignment="Center">Создание аккаунта</Label>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,20,20,0" >
                <Label FontSize="22">Роль:</Label>
                <RadioButton x:Name="rb_client" FontSize="22" Margin="10,0,10,0" VerticalContentAlignment="Center"  IsChecked="{Binding IsClient}">Клиент</RadioButton>
                <RadioButton x:Name="rb_employee" FontSize="22" Margin="10,0,10,0" VerticalContentAlignment="Center" IsChecked="{Binding IsEmployee}" Checked="rb_employee_Checked" Unchecked="rb_employee_Unchecked">Сотрудник</RadioButton>
            </WrapPanel>

            <Border BorderBrush="BurlyWood" BorderThickness="4"/>

            <StackPanel>
                <Label Margin="20" FontSize="20" FontWeight="DemiBold">Введите персональные данные</Label>
                <Label Margin="20,0,20,0" FontSize="16">Фамилия*</Label>
                <TextBox Margin="20,5,20,10" FontSize="16" Height="40" Text="{Binding Surname}"></TextBox>
                <Label Margin="20,0,20,0" FontSize="16">Имя*</Label>
                <TextBox Margin="20,5,20,10" FontSize="16" Height="40" Text="{Binding Firstname}"></TextBox>
                <Label Margin="20,0,20,0" FontSize="16">Отчество*</Label>
                <TextBox Margin="20,5,20,10" FontSize="16" Height="40" Text="{Binding Patronimyc}"></TextBox>
                <Label Margin="20,0,20,0" FontSize="16">Номер телефона*</Label>
                <wpfx:MaskedTextBox Margin="20,5,20,10" FontSize="20" Height="40" IncludeLiteralsInValue="False" Mask="+7(999) 999-99-99" Value="{Binding Number}"></wpfx:MaskedTextBox>
                <Label Margin="20,0,20,0" FontSize="16">Почта*</Label>
                <TextBox Margin="20,5,20,20" FontSize="16" Height="40" Text="{Binding Email}"></TextBox>
            </StackPanel>

            <Border BorderBrush="BurlyWood" BorderThickness="4"/>

            <StackPanel x:Name="panel_employee_info"  Visibility="Collapsed">
                <Label Margin="20" FontSize="20" FontWeight="DemiBold">Введите дополнительные сведения о сотруднике</Label>
                <Label Margin="20,0,20,0" FontSize="16">Должность*</Label>
                <TextBox Margin="20,5,20,10" FontSize="16" Height="40" Text="{Binding Position}"></TextBox>
                <Border BorderBrush="BurlyWood" BorderThickness="4"/>
            </StackPanel>

            <StackPanel>
                <Label Margin="20" FontSize="20" FontWeight="DemiBold">Введите данные для входа*</Label>
                <Label Margin="20,0,20,0" FontSize="16">Введите логин</Label>
                <TextBox Margin="20,5,20,10" FontSize="16" Height="40" Text="{Binding Username}"></TextBox>
                <Label Margin="20,0,20,0" FontSize="16">Придумайте пароль</Label>
                <PasswordBox x:Name="psw_1"  Margin="20,5,20,10" FontSize="16" Height="40" PasswordChanged="psw_1_PasswordChanged" ></PasswordBox>
                <Label Margin="20,0,20,0" FontSize="16">Подтвердите пароль</Label>
                <PasswordBox x:Name="psw_2" Margin="20,5,20,10" FontSize="16" Height="40" PasswordChanged="psw_2_PasswordChanged"></PasswordBox>
            </StackPanel>

            <Button x:Name="btn_register" Margin="50,20,50,50" FontSize="18" Height="40" Command="{Binding RegisterCommand}" >Зарегистрироваться</Button>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,30,30,200">
                <Label FontSize="14">Уже есть аккаунт?</Label>
                <Button x:Name="btn_login" Background="Transparent" BorderThickness="0" Foreground="Blue" FontSize="14" Click="btn_login_Click">Войдите</Button>
            </WrapPanel>

        </StackPanel>

    </ScrollViewer>
    
</Window>
