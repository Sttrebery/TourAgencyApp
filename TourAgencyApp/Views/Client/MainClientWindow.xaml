<Window x:Class="TourAgencyApp.Views.Client.MainClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TourAgencyApp.ViewModels"
        xmlns:views="clr-namespace:TourAgencyApp.Views.Client.Pages"
        xmlns:local="clr-namespace:TourAgencyApp.Views.Client"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Icon="/res/world_travel_icon.ico"
        Height="600" Width="970"
        MinHeight="600" MinWidth="970">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:ActualToursViewModel}">
                <views:ActualTours />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PopularityViewModel}">
                <views:Popularity />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MyToursViewModel}">
                <views:ClientTours />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <views:SearchResults />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ClientProfileViewModel}">
                <views:ClientProfile />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ClientHotelsViewModels}">
                <views:HotelsView/>
            </DataTemplate>
            
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource LeftBorderStyle}">
            <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="10">

                <Label Style="{StaticResource LabelUsername}" Content="{Binding UserName}"></Label>
                <Button x:Name="btn_client_profile" Style="{StaticResource BordersButtonStyle}" Command="{Binding NavigateToProfileCommand}">Профиль</Button>
                <Button x:Name="btn_show_my_tours" Style="{StaticResource BordersButtonStyle}" Command="{Binding NavigateToMyToursCommand}">Мои туры</Button>

                <Button x:Name="btn_popularity" Style="{StaticResource BordersButtonStyle}" Command="{Binding NavigateToPopularityCommand}">Сейчас популярно!</Button>
                <Button x:Name="btn_show_actual_tours" Style="{StaticResource BordersButtonStyle}" Command="{Binding NavigateToActualCommand}" >Актуальные туры</Button>

            </StackPanel>
        </Border>
        

        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,10,0,0">
            <Label Style="{StaticResource LabelStyle1}">Поиск тура по названию:</Label>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0,10,10">
                <TextBox x:Name="tb_name_tour" Width="400" FontSize="16" Text="{Binding SearchVM.SearchText, Mode=TwoWay}"></TextBox>
                <Button x:Name="btn_find" Style="{StaticResource ButtonStyle1}" ToolTip="Поиск" Command="{Binding SearchCommand}">Поиск</Button>
                <Button x:Name="btn_reset" Style="{StaticResource ButtonStyle1}" ToolTip="Стереть содержимое" Command="{Binding SearchVM.ClearTextCommand}">Сброс</Button>
                <Button x:Name="btn_extended" Style="{StaticResource ButtonStyle1}" ToolTip="Расширенный поиск" Command="{Binding ExtendedSearchCommand}">. . .</Button>
            </WrapPanel>

            <WrapPanel>
                <Label Style="{StaticResource LabelStyle1}">Выберите тур:</Label>
                <ComboBox Name="cmb_tour" Style="{StaticResource ComboboxStyle1}" ItemsSource="{Binding AllTours}" SelectedValue="{Binding SelectedTour}" SelectionChanged="ComboBox_SelectionChanged"></ComboBox>
                <Button Name="btn_tourSign" Style="{StaticResource ButtonStyle1}" Command="{Binding SignUpForTourCommand}">Записаться</Button>
            </WrapPanel>
        </StackPanel>

        <Frame x:Name="frame_content" Grid.Column="1" Grid.Row="1" Style="{StaticResource MainFrameStyle}" Content="{Binding CurrentPage}"></Frame>
        
    </Grid>
</Window>
