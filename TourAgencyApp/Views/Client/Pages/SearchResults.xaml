<Page x:Class="TourAgencyApp.Views.Client.Pages.SearchResults"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAgencyApp.Views.Client.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SearchResults">
    <Page.Resources>
        <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
    </Page.Resources>

    <ScrollViewer  Background="#c2dbfc" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Label Content="Найденные туры" Style="{StaticResource LabelPageHeader}" />
            <DataGrid ItemsSource="{Binding SearchResults}"  AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                    <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                    <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                    <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                    <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
