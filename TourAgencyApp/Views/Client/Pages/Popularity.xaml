<Page x:Class="TourAgencyApp.Views.Client.Pages.Popularity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TourAgencyApp.Views.Client.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Popularity">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dictionaries/PagesDictionary.xaml"/>
                <ResourceDictionary Source="/Dictionaries/MainWindowDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Background="#c2dbfc" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource BorderStyle1}">
                <StackPanel Margin="3">
                    <WrapPanel Margin="0,10,0,10">
                        <Label Style="{StaticResource LabelStyle2}">Самая популярная страна:</Label>
                        <TextBlock Margin="20,0,20,0" FontSize="20" Padding="5" TextDecorations="Underline" Text="{Binding TopCountryName}"></TextBlock>
                    </WrapPanel>

                    <WrapPanel Margin="0,10,0,10">
                        <Label Style="{StaticResource LabelStyle2}" >Количество туров, посещающих эту страну:</Label>
                        <TextBlock FontSize="20" Padding="5" Margin="20,0,20,0" FontWeight="Bold" Text="{Binding TopCountryCount}"></TextBlock>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource BorderStyle1}">
                <StackPanel Margin="10">
                    <Label Style="{StaticResource LabelStyle2}">Самый популярный тур</Label>
                    <DataGrid ItemsSource="{Binding TopTour}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                            <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>


            <Border Grid.Row="2" Style="{StaticResource BorderStyle1}">
                <StackPanel Margin="3">
                    <Label Style="{StaticResource LabelStyle2}">Самый популярный архивный тур</Label>
                    <DataGrid ItemsSource="{Binding TopArchiveTour}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding NameTour}" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding CostTour}" />
                            <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate}" />
                            <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate}" />
                            <DataGridTextColumn Header="Количество мест" Binding="{Binding MaxValueTourist}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>


            <Border Grid.Row="3" Style="{StaticResource BorderStyle1}">
                <StackPanel Margin="10">
                    <Label Style="{StaticResource LabelStyle2}">Самый популярный отель</Label>
                    <DataGrid ItemsSource="{Binding TopHotel}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Название" Binding="{Binding Name_}" />
                            <DataGridTextColumn Header="Местоположение" Binding="{Binding Location_}" />
                            <DataGridTextColumn Header="Информация об отеле" Binding="{Binding  Information_}" />
                            <DataGridTextColumn Header="Фото" Binding="{Binding ImageHotel}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>

</Page>
