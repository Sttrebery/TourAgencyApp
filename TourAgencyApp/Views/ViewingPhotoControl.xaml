<UserControl x:Class="TourAgencyApp.Views.ViewingPhotoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TourAgencyApp.Views"
             xmlns:conv="clr-namespace:TourAgencyApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:ByteArrayToImageConverter x:Key="ByteToImageConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ListView x:Name="ImagesListView" ItemsSource="{Binding Images, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Превью">
                        <GridViewColumn.Width>
                            <Binding ElementName="ImagesListView" Path="ActualWidth" />
                        </GridViewColumn.Width>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Path=PhotoValue, Converter={StaticResource ByteToImageConverter}}" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Height="200" Stretch="Uniform" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </ScrollViewer>
</UserControl>
