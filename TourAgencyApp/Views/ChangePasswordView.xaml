<Window x:Class="TourAgencyApp.Views.ChangePasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourAgencyApp.Views"
        mc:Ignorable="d"
        Title="Изменение пароля" Height="350" Width="800">
    <StackPanel>
        <Label Margin="20,0,20,0" FontSize="16">Введите новый пароль:</Label>
        <PasswordBox x:Name="psw_1" Margin="20,5,20,10" FontSize="16" Height="40" PasswordChanged="psw_1_PasswordChanged" ></PasswordBox>
        <Label Margin="20,0,20,0" FontSize="16">Подтвердите новый пароль:</Label>
        <PasswordBox x:Name="psw_2"  Margin="20,5,20,10" FontSize="16" Height="40" PasswordChanged="psw_2_PasswordChanged" ></PasswordBox>
        <Button x:Name="btn_cofirm" FontSize="16" Width="150" Height="30" Command="{Binding ConfirmCommand}">Подтвердить</Button>
    </StackPanel>
</Window>
