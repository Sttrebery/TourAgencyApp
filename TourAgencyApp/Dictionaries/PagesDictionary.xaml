<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LabelPageHeader" TargetType="{x:Type Label}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Noto Sans Hebrew"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="LabelStyle2" TargetType="{x:Type Label}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="TextboxProfileStyle" TargetType="{x:Type TextBox}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Width" Value="240"/>
    </Style>

    <Style x:Key="BorderStyle1" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#eaf1f1"/>
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="BorderBrush" Value="#757f99"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="5"/>
    </Style>


</ResourceDictionary>